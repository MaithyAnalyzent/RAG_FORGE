# ── LLM Provider Keys ─────────────────────────────────────────────────────────
# Set the key for whichever provider you configure in configs/default.yaml.

OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# ── Config Override ────────────────────────────────────────────────────────────
# Point to a different YAML config file (default: configs/default.yaml).
# RAG_CONFIG_PATH=configs/production.yaml

# ── Ollama ─────────────────────────────────────────────────────────────────────
# Override the Ollama server URL if it is not running on localhost.
# OLLAMA_ENDPOINT=http://localhost:11434
